		{
			"name": "3. Emergencies",
			"item": [
				{
					"name": "Create Emergency (AI Priority & Dispatch)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if(jsonData.data && jsonData.data.id) {",
									"    pm.collectionVariables.set('emergencyId', jsonData.data.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"emergencyType\": \"CARDIAC_ARREST\",\n  \"description\": \"Patient experiencing severe chest pain and breathlessness\",\n  \"severity\": \"CRITICAL\",\n  \"latitude\": 17.4325,\n  \"longitude\": 78.4071,\n  \"patientAge\": 58,\n  \"isUnconscious\": true,\n  \"hasSevereBleeding\": false,\n  \"hasBreathingDifficulty\": true,\n  \"isMajorAccident\": false,\n  \"isChestPain\": true\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/emergencies",
							"host": ["{{baseUrl}}"],
							"path": ["emergencies"]
						}
					}
				},
				{
					"name": "Get Emergency By ID",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"url": {
							"raw": "{{baseUrl}}/emergencies/{{emergencyId}}",
							"host": ["{{baseUrl}}"],
							"path": ["emergencies", "{{emergencyId}}"]
						}
					}
				},
				{
					"name": "Get My Emergencies",
