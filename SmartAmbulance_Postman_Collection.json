						"body": {
							"mode": "raw",
							"raw": "{\n  \"status\": \"EN_ROUTE\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/emergencies/{{emergencyId}}/status",
							"host": ["{{baseUrl}}"],
							"path": ["emergencies", "{{emergencyId}}", "status"]
