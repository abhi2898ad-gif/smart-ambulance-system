# ===================================================================
# SmartAmbulance Environment Variables Guide
# ===================================================================

# -------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vercel / Local Vite)
# -------------------------------------------------------------------
# Local development:
VITE_API_BASE_URL=http://localhost:8080/api

# Production on Vercel (Point to your live Render backend):
# VITE_API_BASE_URL=https://smart-ambulance-backend.onrender.com/api


# -------------------------------------------------------------------
# 2. BACKEND & AIVEN MYSQL ENVIRONMENT VARIABLES (Render / Local)
# -------------------------------------------------------------------
# Local MySQL:
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/smart_ambulance_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
# SPRING_DATASOURCE_USERNAME=root
# SPRING_DATASOURCE_PASSWORD=your_password

# Aiven Cloud MySQL (Copy from your Aiven Console):
# Example Aiven URI format:
# SPRING_DATASOURCE_URL=jdbc:mysql://mysql-xxxx.aivencloud.com:xxxxx/defaultdb?sslMode=REQUIRED&serverTimezone=UTC
# SPRING_DATASOURCE_USERNAME=avnadmin
# SPRING_DATASOURCE_PASSWORD=your_aiven_password

# Server Port (Render injects this dynamically)
PORT=8080

# JWT Authentication Secret (64+ hex characters)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated origins for production)
# Example: https://smart-ambulance.vercel.app,http://localhost:5173
CORS_ALLOWED_ORIGINS=https://smart-ambulance.vercel.app,http://localhost:5173
